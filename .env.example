# Public URL of the live site (used for SEO: canonical links, sitemap, Open Graph)
SITE_URL=https://www.ilizaterrahomes.com

# Postgres database. On Vercel this is set automatically when you connect a
# Neon (Vercel Postgres) or Prisma Postgres database from the project's Storage tab.
DATABASE_URL=postgres://user:password@localhost:5432/iliza

# First admin account (created automatically on first start; change the password after logging in)
ADMIN_EMAIL=ilizaterrahomes@gmail.com
ADMIN_PASSWORD=ChangeMe-2026!

# Long random string used to sign admin login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string

# Optional: Vercel Blob for image uploads (otherwise images are stored in the database)
BLOB_READ_WRITE_TOKEN=

# Optional: email notifications for new enquiries via Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_FROM=Iliza Terra Homes <website@ilizaterrahomes.com>
